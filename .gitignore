# ============================================================
# BPLab Trace — .gitignore
# ============================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
*.manifest
*.spec

# ── Virtual Environments ──
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pip-wheel-metadata/

# ── IDE / Editor ──
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── OS Files ──
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Environment / Secrets ──
.env
.env.local
.env.*.local
*.secret

# ── Logs ──
logs/
*.log
backend/server.log

# ── Testing ──
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ── Cache ──
*.cache
.cache/

# ── Application Runtime Data ──
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/attachments/
data/outputs/
data/signatures/
data/uploads/

# ── Backend Specific ──
backend/__pycache__/
backend/app/__pycache__/
backend/app/*/__pycache__/
backend/app/*/*/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/*.log

# ── Frontend ──
frontend/dist/
frontend/node_modules/
frontend/.vite/
frontend/*.log

# ── Docker ──
.docker/
docker-compose.override.yml

# ── Archive / Reference / Temp ──
*.zip
*.rar
*.tar.gz
*.7z
资料/
temp/
tmp/
*.tmp

# ── Streamlit (legacy) ──
.streamlit/secrets.toml

# ── Jupyter ──
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ── Misc ──
bp-lims-main (1).zip
*.bak

# ── Temp files (session artifacts) ──
tmp_req.json
i011_preview.html
*_output.docx
test_record*.docx
test_report*.docx
test_payload.json

# ── Claude / AI assistant ──
.claude/
CLAUDE.md
.npm-cache/

